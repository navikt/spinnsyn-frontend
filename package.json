    },
    "dependencies": {
        "@date-fns/tz": "^1.5.0",
        "@grafana/faro-web-sdk": "^2.9.0",
        "@navikt/aksel-icons": "^8.16.1",
        "@navikt/ds-css": "^8.16.1",
        "@navikt/ds-react": "^8.16.1",
        "@navikt/ds-tailwind": "^8.16.1",
        "@navikt/ds-tokens": "^8.16.1",
        "@navikt/nav-dekoratoren-moduler": "^4.2.2",
        "@navikt/next-api-proxy": "^5.0.5",
        "@navikt/next-logger": "^5.0.0",
        "@navikt/oasis": "^3.8.0",
        "@tanstack/react-query": "^5.101.4",
        "@unleash/nextjs": "^1.6.7",
        "classnames": "^2.5.1",
        "cookie": "^2.0.1",
        "date-fns": "^4.4.0",
        "html-react-parser": "^6.1.5",
        "jose": "^6.2.8",
        "next-logger": "^5.0.2",
        "node-cache": "^5.1.2",
        "pino-pretty": "^13.1.3",
        "prom-client": "^15.1.3",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "remeda": "^2.39.0",
        "tailwind-merge": "^3.6.0",
        "typescript": "6.0.3",
        "uuid": "^14.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@navikt/tsm-prettier": "^2.0.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "4.3.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/classnames": "^2.3.4",
        "@types/node": "^22.10.5",
        "@types/react": "^19.2.18",
        "@types/uuid": "^11.0.0",
        "@vitejs/plugin-react": "^6.0.5",
        "autoprefixer": "^10.5.4",
        "axe-core": "^4.13.0",
        "eslint": "9.39.5",
        "eslint-config-next": "^16.3.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.4.0",
        "jsdom": "^30.0.1",
        "next": "^16.3.0",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "start-server-and-test": "^3.0.12",
        "tailwindcss": "4.3.3",
        "ts-loader": "^9.6.2",
        "vitest": "^4.1.10"
    },
    "scripts": {
        "dev": "NEXT_PUBLIC_MOCK_BACKEND=true next dev -p 3000 | pino-pretty",
        "dev-ingen-dekorator": "NEXT_PUBLIC_MOCK_BACKEND=true NO_DECORATOR=true npm run dev | pino-pretty",
        "interne": "NEXT_PUBLIC_SPINNSYN_FRONTEND_INTERNE=true NO_DECORATOR=true npm run dev | pino-pretty",
        "start": "next start -p 3000",
        "start-ingen-dekorator": "NO_DECORATOR=true npm start",
        "arkiv": "npm run build && npm run start-ingen-dekorator",
        "build": "next build",
        "test": "vitest",
        "test:ci": "vitest --run",
        "play": "PLAYWRIGHT_ALL=true npx playwright test --ui",
        "play-headless": "PLAYWRIGHT_HTML_OPEN=never npx playwright test",
        "play-build": "export PLAYWRIGHT_ALL=true BUILD=true; npm run build && npx playwright test --ui",
        "play-headless-build": "PLAYWRIGHT_HTML_OPEN=never export BUILD=true; npm run build && npx playwright test",
        "prettier:write": "prettier --write .",
        "prettier:check": "prettier --check .",
        "lint": "eslint src playwright",
        "lint:fix": "eslint src playwright --fix",
        "format": "npm run prettier:write && npm run lint:fix"
    },
    "prettier": "@navikt/tsm-prettier"
}
